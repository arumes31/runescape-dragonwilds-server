# Copy to .env. Keep comments on separate lines. Quote literal $ and # values with single quotes.
COMPOSE_PROJECT_NAME=dragonwilds
PUID=1000
PGID=1000
# 32-character hexadecimal Player ID from the game's Settings menu (not Steam ID).
OWNER_ID=
ADMIN_PASSWORD=
WORLD_PASSWORD=
SERVER_NAME=DragonWildsServer
# The world name is visible in the in-game Worlds browser. Existing saves retain their identity.
DEFAULT_WORLD_NAME=MyWorld
DEFAULT_PORT=7777
# Must be DEFAULT_PORT + 1111. Forward both UDP ports with identical host/container numbers.
BEACON_PORT=8888
MAX_PLAYERS=6
MULTIHOME=
UPDATE_ON_START=true
# true merges environment-managed settings, preserving identity, bans and unknown fields.
# false keeps an existing INI untouched. First startup still creates one.
GENERATE_SETTINGS=true
BACKUP_KEEP=7
SERVER_DATA_PATH=./server-files
BACKUP_PATH=./backups
GAME_BIND_IP=0.0.0.0
# Admin is reachable on all interfaces for a reverse proxy. Restrict inbound 8080 to that proxy.
ADMIN_BIND_IP=0.0.0.0
ADMIN_PORT=8080
# Separate panel login password; at least 20 characters.
ADMIN_GUI_PASSWORD=
# Comma-separated exact URLs without trailing slashes. Set your real HTTPS reverse-proxy URL here.
# HTTPS-only origins enable Secure cookies. Proxy must preserve Host.
ADMIN_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Exact proxy IPs/CIDRs, comma-separated; empty ignores forwarding headers.
# Example for a proxy with a fixed Docker IP: ADMIN_TRUSTED_PROXIES=172.30.0.2/32
# Proxy must overwrite or append X-Forwarded-For with the actual client IP.
ADMIN_TRUSTED_PROXIES=
# Daily UTC window for ALL automatic restarts: anytime or HH:MM-HH:MM (may cross midnight).
# Panel edits persist in admin-state and override this default until Reset to environment.
AUTO_UPDATE_WINDOW_UTC=anytime
# Check Steam every 5 minutes; restart for newer builds, at most once per 2 hours.
AUTO_UPDATE=true
# Optional additional daily restart hour in UTC (0-23), or off. Same automatic cooldown.
AUTO_UPDATE_UTC_HOUR=off
# On Linux: stat -c '%g' /var/run/docker.sock
DOCKER_GID=0

# Optional prebuilt GHCR images; omit to build local source.
# Published by successful main-branch GHCR runs; use a release tag or digest if preferred.
# GAME_IMAGE=ghcr.io/arumes31/runescape-dragonwilds-server:dev
# ADMIN_IMAGE=ghcr.io/arumes31/runescape-dragonwilds-server-admin:dev
